data
/data
./data

# Rust build output (the nested projects lost their own .gitignore when the
# sub-repo .git dirs were removed).
target/

# Go binaries built in-tree by the projects' own build scripts. Each is named
# after its directory, so the path doubles up.
/xbh/xbh
/xmem/xmem

# Release packaging scratch dirs used by .github/workflows/release.yml.
# Unanchored: the workflow stages into <project>/dist/ as well as ./artifacts/.
dist/
artifacts/

# Machine-local agent state.
.claude/settings.local.json

# Secrets: xssh reads a server key and logs from its working dir.
*.key
memfd-log.txt
